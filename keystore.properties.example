# Copy to keystore.properties (gitignored) and fill in. storeFile may be
# absolute or relative to the project root. Keep the keystore itself
# somewhere safe and OUT of the repo - losing it means you can't ship
# updates to the same signed APK.
storeFile=/path/to/sidereal-release.jks
storePassword=changeme
keyAlias=sidereal
keyPassword=changeme
