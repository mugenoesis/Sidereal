      UI added from this point on should reference these.
    -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="overlay_scrim">#66000000</color>
    <color name="overlay_scrim_strong">#AA000000</color>
    <color name="overlay_pill_fill">#4DFFFFFF</color>
    <color name="accent_cyan">#4CC2FF</color>
    <color name="status_recording">#FFE53935</color>
    <color name="status_pending">#FFFB8C00</color>
    <color name="status_focus_reticle">#FF4CC2FF</color>
    <color name="status_spot_meter_reticle">#FFFFD54F</color>
    <color name="control_disabled">#664D4D4D</color>
</resources>
