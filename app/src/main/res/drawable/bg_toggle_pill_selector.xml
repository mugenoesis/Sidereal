<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drives ToggleButton's on/off visual purely from its built-in
         checked state - no MainActivity code needed, same idea as
         bg_segment_selected but reactive instead of manually swapped. -->
    <item android:state_checked="true" android:drawable="@drawable/bg_segment_selected" />
    <item android:drawable="@android:color/transparent" />
</selector>
